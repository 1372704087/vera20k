# Kept visible: a root CLAUDE.md would stop Claude Code reading AGENTS.md.
!/CLAUDE.md
!/AGENTS.md

/*.js
/*.py

# throwaway verification build dir (parallel-session exe lock workaround)
/target-verify/

# Scratch area for deletes and one-off scripts; never a deliverable.
/_trash/

# Dashboard build dependencies; compiled JS is intentionally tracked.
/tools/telemetry-dashboard/node_modules/

# --- Android (android/) ---
# Gradle output, the machine-local SDK path, the generated debug keystore, and
# the native libraries cargo-ndk writes into the APK's jniLibs directory: all
# generated, none committed.
/android/.gradle/
/android/.kotlin/
/android/.android/
/android/local.properties
/android/**/build/
/android/app/src/main/jniLibs/
