{
  "schema_version": "vera20k.map-observation-expectations.v1",
  "assertions": [
    {
      "name": "Initial stock wallet",
      "subject": {
        "house": "VERA-OBSERVER"
      },
      "field": "economy.credits",
      "op": "eq",
      "value": 10000,
      "at_step": 0
    },
    {
      "name": "Destroyer is charged exactly once",
      "subject": {
        "house": "VERA-OBSERVER"
      },
      "field": "economy.spent_credits",
      "op": "eq",
      "value": 1000,
      "at_step": 1200
    },
    {
      "name": "Final wallet reflects the paid Destroyer",
      "subject": {
        "house": "VERA-OBSERVER"
      },
      "field": "economy.credits",
      "op": "eq",
      "value": 9000,
      "at_step": 1200
    },
    {
      "name": "Production grants no ore score",
      "subject": {
        "house": "VERA-OBSERVER"
      },
      "field": "economy.score",
      "op": "eq",
      "value": 0,
      "always": {
        "from_step": 0,
        "through_step": 1200
      }
    },
    {
      "name": "Original held Destroyer begins in limbo",
      "subject": {
        "actor": {
          "type_id": "DEST",
          "owner": "VERA-OBSERVER",
          "bind_step": 20
        }
      },
      "field": "in_limbo",
      "op": "eq",
      "value": true,
      "at_step": 20
    },
    {
      "name": "Original held Destroyer is delivered",
      "subject": {
        "actor": {
          "type_id": "DEST",
          "owner": "VERA-OBSERVER",
          "bind_step": 20
        }
      },
      "field": "in_limbo",
      "op": "eq",
      "value": false,
      "eventually": {
        "from_step": 21,
        "through_step": 1200
      }
    },
    {
      "name": "Delivered Destroyer is healthy",
      "subject": {
        "actor": {
          "type_id": "DEST",
          "owner": "VERA-OBSERVER",
          "bind_step": 20
        }
      },
      "field": "health",
      "op": "eq",
      "value": 600,
      "at_step": 1200
    },
    {
      "name": "Delivered Destroyer is Cell marked",
      "subject": {
        "actor": {
          "type_id": "DEST",
          "owner": "VERA-OBSERVER",
          "bind_step": 20
        }
      },
      "field": "cell_marked",
      "op": "eq",
      "value": true,
      "at_step": 1200
    },
    {
      "name": "Delivered Destroyer remains in Logic",
      "subject": {
        "actor": {
          "type_id": "DEST",
          "owner": "VERA-OBSERVER",
          "bind_step": 20
        }
      },
      "field": "in_logic_vector",
      "op": "eq",
      "value": true,
      "at_step": 1200
    },
    {
      "name": "Producer enters Unload",
      "subject": {
        "actor": {
          "type_id": "GAYARD",
          "owner": "VERA-OBSERVER"
        }
      },
      "field": "mission.current",
      "op": "eq",
      "value": 16,
      "eventually": {
        "from_step": 21,
        "through_step": 1200
      }
    },
    {
      "name": "Producer reaches naval Unload state4",
      "subject": {
        "actor": {
          "type_id": "GAYARD",
          "owner": "VERA-OBSERVER"
        }
      },
      "field": "mission.handler_state",
      "op": "eq",
      "value": 4,
      "eventually": {
        "from_step": 21,
        "through_step": 1200
      }
    },
    {
      "name": "Producer returns to Guard",
      "subject": {
        "actor": {
          "type_id": "GAYARD",
          "owner": "VERA-OBSERVER"
        }
      },
      "field": "mission.current",
      "op": "eq",
      "value": 5,
      "at_step": 1200
    },
    {
      "name": "Producer retains no radio contact",
      "subject": {
        "actor": {
          "type_id": "GAYARD",
          "owner": "VERA-OBSERVER"
        }
      },
      "field": "radio.contacts",
      "op": "eq",
      "value": [
        null
      ],
      "always": {
        "from_step": 0,
        "through_step": 1200
      }
    }
  ]
}
