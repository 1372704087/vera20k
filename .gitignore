**/target/
**/__pycache__/
**/*.py[co]
**/graphify-out/

config.toml

.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store

*.png
*.pcx
*.log
*.txt
!tools/requirements-test.txt
*.tmp
*.map
*_todo.md

# No trailing slash: a linked worktree reaches the retail INIs through an
# `ini` symlink, which a directory-only pattern does not match.
/ini

/infodocs/

/docs/*
!/docs/_config.yml
!/docs/index.md
!/docs/Networking.md
!/docs/ar/
!/docs/de/
!/docs/ru/
!/docs/sv/
!/docs/th/
!/docs/tr/
!/docs/zh-CN/
!/docs/images/
!/docs/images/**

.mcp.json
/.claude/*
!/.claude/skills/
/.claude/skills/ghidra-up/
/.agents/*
!/.agents/skills/
/.agents/skills/ghidra-up/
/todo/
/logs/
/saves/
/replays/

tools/vendor-eval/

/*.md
!/README.md
!/README.sv.md
!/README.de.md
!/README.zh-CN.md
!/README.ar.md
!/README.ru.md
!/README.th.md
!/README.tr.md
# Kept visible: a root CLAUDE.md would stop Claude Code reading AGENTS.md.
!/CLAUDE.md
!/AGENTS.md

/*.js
/*.py

# throwaway verification build dir (parallel-session exe lock workaround)
/target-verify/

# dashboard dependencies (npm install output, not source)
node_modules/

# local tool state: session screenshots, backups, memory
.workbuddy/

# generated match reports (the engine writes these per match)
tools/telemetry-dashboard/reports/

# local map harness: imports map3d.js by relative path, so it has to sit in
# the web root to run same-origin. Scratch, not a shipped dashboard file.
tools/telemetry-dashboard/map-harness.html
